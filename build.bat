@echo off
rem Builds GpuToggle.exe with the C# compiler that ships with Windows (.NET Framework 4.x).
rem Uses forward slashes only (backslashes can get stripped when downloading).
rem The version comes from the VERSION file (release.ps1 bumps it). Set NOPAUSE=1 to skip the final pause.
cd /d "%~dp0"
set "CSC=%SystemRoot%/Microsoft.NET/Framework64/v4.0.30319/csc.exe"
if not exist "%CSC%" (
  echo csc.exe not found: %CSC%
  if not "%NOPAUSE%"=="1" pause
  exit /b 1
)

set "VER=0.0.0"
if exist VERSION set /p VER=<VERSION
for /f "tokens=* delims= " %%a in ("%VER%") do set "VER=%%a"
> Version.cs echo // Generated by build.bat from the VERSION file. Do not edit.
>> Version.cs echo using System.Reflection;
>> Version.cs echo [assembly: AssemblyTitle("GPU Toggle")]
>> Version.cs echo [assembly: AssemblyProduct("GPU Toggle")]
>> Version.cs echo [assembly: AssemblyVersion("%VER%.0")]
>> Version.cs echo [assembly: AssemblyFileVersion("%VER%.0")]
>> Version.cs echo [assembly: AssemblyInformationalVersion("%VER%")]
>> Version.cs echo namespace GpuToggle { static class AppVersion { public const string Text = "%VER%"; } }

"%CSC%" /nologo /target:winexe /platform:x64 /optimize+ /out:GpuToggle.exe /win32manifest:app.manifest /win32icon:app.ico /resource:app.ico /r:System.dll /r:System.Drawing.dll /r:System.Windows.Forms.dll /r:System.Management.dll GpuToggle.cs Osd.cs Version.cs
if errorlevel 1 (
  echo.
  echo Build FAILED
  if not "%NOPAUSE%"=="1" pause
  exit /b 1
)
echo.
echo Built GpuToggle.exe v%VER%
if not "%NOPAUSE%"=="1" pause
