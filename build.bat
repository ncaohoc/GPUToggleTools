@echo off
rem Builds GpuToggle.exe with the C# compiler that ships with Windows (.NET Framework 4.x).
rem Compiles every .cs file under src/ (C# 5 syntax, ASCII, no backslashes in the sources).
rem Uses forward slashes only (backslashes can get stripped when downloading).
rem The version comes from the VERSION file (release.ps1 bumps it). Set NOPAUSE=1 to skip the final pause.
cd /d "%~dp0"
set "ROOT=%~dp0"
set "CSC=%SystemRoot%/Microsoft.NET/Framework64/v4.0.30319/csc.exe"
if not exist "%CSC%" (
  echo csc.exe not found: %CSC%
  if not "%NOPAUSE%"=="1" pause
  exit /b 1
)

set "VER=0.0.0"
if exist VERSION set /p VER=<VERSION
for /f "tokens=* delims= " %%a in ("%VER%") do set "VER=%%a"
set "VCS=src/Version.cs"
> "%VCS%" echo // Generated by build.bat from the VERSION file. Do not edit.
>> "%VCS%" echo using System.Reflection;
>> "%VCS%" echo [assembly: AssemblyTitle("GPU Toggle")]
>> "%VCS%" echo [assembly: AssemblyProduct("GPU Toggle")]
>> "%VCS%" echo [assembly: AssemblyVersion("%VER%.0")]
>> "%VCS%" echo [assembly: AssemblyFileVersion("%VER%.0")]
>> "%VCS%" echo [assembly: AssemblyInformationalVersion("%VER%")]
>> "%VCS%" echo namespace GpuToggle { static class AppVersion { public const string Text = "%VER%"; } }

rem Runs inside src/ because csc does not accept forward slashes in /recurse; the other paths are absolute.
pushd src
"%CSC%" /nologo /target:winexe /platform:x64 /optimize+ /out:"%ROOT%GpuToggle.exe" /win32manifest:"%ROOT%app.manifest" /win32icon:"%ROOT%app.ico" /resource:"%ROOT%app.ico",app.ico /r:System.dll /r:System.Drawing.dll /r:System.Windows.Forms.dll /r:System.Management.dll /recurse:*.cs
set "ERR=%ERRORLEVEL%"
popd
if not "%ERR%"=="0" (
  echo.
  echo Build FAILED
  if not "%NOPAUSE%"=="1" pause
  exit /b 1
)
echo.
echo Built GpuToggle.exe v%VER%
if not "%NOPAUSE%"=="1" pause
